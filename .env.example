# Copy to .env.local (ignored by git) and adjust.

# Google OAuth client ID (Web application). Created in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=

# On iPhone/iPad the welcome page asks users to install the app before signing in.
# Set to "false" to turn that gate off, for example during local development.
VITE_REQUIRE_INSTALL=true

# Lets people delete a group on their own device (hidden from their lists, kept in the backup) and see the
# deleted ones. Off unless this is "true"; with it off, groups already deleted stay hidden.
VITE_ENABLE_DELETE_GROUP=false
